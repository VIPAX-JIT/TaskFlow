# TaskFlow backend – environment template
# Copy this file to .env and fill in real values before running.

# HTTP port
PORT=5000

# MongoDB connection string.
# Leave blank (or unset NODE_ENV=production) to start an in-memory MongoDB
# automatically. In production, set this to a real Atlas/MongoDB URI.
MONGODB_URI=

# JWT signing secret. Use a long, random value in production.
JWT_SECRET=replace_me_with_a_long_random_secret

# "development" | "production"
# production disables the in-memory DB and demo seed (unless SEED_ON_START=true).
NODE_ENV=development

# Force seed in production (default: only runs in development).
SEED_ON_START=false
